---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/shared/Nav.astro';
import PageHero from '@/components/shared/PageHero.astro';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';
import SectionEyebrow from '@/components/shared/SectionEyebrow.astro';
import SiteFooter from '@/components/shared/SiteFooter.astro';
import { cateringChennai } from '@/lib/hero-images';
import { WHATSAPP_QUOTE_URL } from '@/lib/contact';
---

<BaseLayout
  title="Catering in Chennai — Elamrit Luxe Feast"
  description="Premium catering in Chennai for weddings, corporate events, and social celebrations. Elamrit Luxe Feast brings world-class culinary standards to the gateway of South India."
  bottomCta="about"
>
  <Nav variant="solid" />

  <PageHero
    variant="split"
    breadcrumb={[
      { label: 'Home', href: '/' },
      { label: 'Locations', href: '/catering-in' },
      { label: 'Catering in Chennai' },
    ]}
    titleHtml="CATERING<br />IN<br />CHENNAI"
    description="Where Chettinad depth meets coastal refinement — Chennai hosts expect food with soul, service with grace, and execution without compromise."
    descriptionClass="w-full max-w-none"
    imageClass="ph-image"
    heroImageSrc={cateringChennai}
    quote="Chennai's guests don't separate tradition from ambition. Neither do we."
    quoteAttribution="Elamrit"
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href={WHATSAPP_QUOTE_URL} variant="creamOnDark">Plan Your Event</Button>
      <Button href="/services/wedding-catering" variant="outlineCream">Wedding Catering</Button>
    </div>
  </PageHero>

  <!-- Story section -->
  <section class="grid grid-cols-1 items-center gap-16 bg-cream px-5 py-20 md:gap-24 md:px-10 lg:grid-cols-2 lg:gap-[100px] lg:px-20 lg:py-[110px]">
    <div class="story-image relative">
      <div class="story-img-main relative aspect-[3/4] w-full overflow-hidden bg-[color-mix(in_srgb,var(--cream)_72%,var(--gray-orange)_28%)]"></div>
      <div class="story-img-float absolute -right-10 -bottom-10 hidden aspect-square w-[55%] overflow-hidden bg-dark-red md:block"></div>
      <div class="absolute -left-5 top-7 bg-dark-red px-5 py-3 font-display text-xs tracking-[0.26em] text-cream uppercase">
        Chennai · Gateway South
      </div>
    </div>
    <div>
      <SectionEyebrow class="mb-4">Operating in Chennai</SectionEyebrow>
      <h2 class="mb-8 font-serif text-[clamp(30px,3.5vw,46px)] font-light leading-tight text-dark-brown">
        Tradition at the table, <em class="italic text-dark-red">precision in service</em>
      </h2>
      <p class="mb-5 font-body text-[18px] leading-[1.85] text-[var(--text-muted-on-cream)]">
        Chennai's event landscape spans grand hotel ballrooms along the GST corridor, intimate celebrations in Adyar and Nungambakkam, and corporate gatherings across OMR's tech parks. The city's palate is unmistakably South Indian — Chettinad spice, coastal seafood, filter-coffee hospitality — yet its hosts are among India's most globally minded. We design menus that honour Tamil culinary roots while delivering the international breadth and presentation standards Chennai's finest occasions demand.
      </p>
      <blockquote class="my-9 border-l-[3px] border-dark-red bg-light-blush py-4 pr-7 pl-7">
        <p class="m-0 font-serif text-[clamp(19px,2vw,22px)] italic leading-[1.65] text-dark-brown">
          "In Chennai, generosity is part of the menu. Every plate should feel like an invitation, not an allocation."
        </p>
      </blockquote>
      <p class="font-body text-[18px] leading-[1.85] text-[var(--text-muted-on-cream)]">
        From a 40-guest house-warming in Besant Nagar to a 700-guest wedding at a five-star property, our Chennai deployments follow the same advance planning, kitchen walkthroughs, and service rehearsals that define every Elamrit event nationwide.
      </p>
      <Button href={WHATSAPP_QUOTE_URL} variant="storyLink">Enquire for Chennai</Button>
    </div>
  </section>

  <!-- Services in Chennai -->
  <section class="bg-dark-red px-5 py-20 md:px-10 lg:px-20 lg:py-24">
    <div class="mb-14 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <span class="mb-3 block font-body text-xs tracking-[0.28em] text-gray-orange uppercase">What We Offer in Chennai</span>
        <h2 class="font-serif text-[clamp(28px,3.2vw,46px)] font-light leading-tight text-cream">
          South Indian soul, <em class="italic">world-class craft</em>
        </h2>
      </div>
      <p class="max-w-[420px] font-body text-[17px] leading-[1.8] text-cream/65 lg:text-right">
        Weddings, corporate events, and social celebrations — Elamrit's full portfolio is available across Chennai.
      </p>
    </div>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <a href="/services/wedding-catering" class="block">
        <Card variant="location" class="h-full">
          <span class="mb-2 block font-body text-[10px] tracking-[0.25em] text-gray-orange uppercase">Weddings</span>
          <h3 class="mb-3 font-serif text-xl font-light leading-snug text-dark-brown">Wedding Catering</h3>
          <p class="font-body text-[15px] leading-[1.7] text-[var(--text-muted-on-cream)]">Traditional and multicultural weddings at Chennai's landmark hotels and banquet properties.</p>
        </Card>
      </a>
      <a href="/services/corporate-catering" class="block">
        <Card variant="location" class="h-full">
          <span class="mb-2 block font-body text-[10px] tracking-[0.25em] text-gray-orange uppercase">Corporate</span>
          <h3 class="mb-3 font-serif text-xl font-light leading-snug text-dark-brown">Corporate Catering</h3>
          <p class="font-body text-[15px] leading-[1.7] text-[var(--text-muted-on-cream)]">Conferences, product launches, and executive dining across OMR, Guindy, and the CBD.</p>
        </Card>
      </a>
      <a href="/services/social-celebrations" class="block">
        <Card variant="location" class="h-full">
          <span class="mb-2 block font-body text-[10px] tracking-[0.25em] text-gray-orange uppercase">Social</span>
          <h3 class="mb-3 font-serif text-xl font-light leading-snug text-dark-brown">Social Celebrations</h3>
          <p class="font-body text-[15px] leading-[1.7] text-[var(--text-muted-on-cream)]">Birthdays, anniversaries, and milestone gatherings crafted for Chennai's gracious hosts.</p>
        </Card>
      </a>
      <a href="/services/live-stations" class="block">
        <Card variant="location" class="h-full">
          <span class="mb-2 block font-body text-[10px] tracking-[0.25em] text-gray-orange uppercase">Experiential</span>
          <h3 class="mb-3 font-serif text-xl font-light leading-snug text-dark-brown">Live Stations</h3>
          <p class="font-body text-[15px] leading-[1.7] text-[var(--text-muted-on-cream)]">Interactive live cooking — from dosa and Chettinad grills to global stations with theatrical flair.</p>
        </Card>
      </a>
      <a href="/services/private-dining" class="block">
        <Card variant="location" class="h-full">
          <span class="mb-2 block font-body text-[10px] tracking-[0.25em] text-gray-orange uppercase">Intimate</span>
          <h3 class="mb-3 font-serif text-xl font-light leading-snug text-dark-brown">Private Dining</h3>
          <p class="font-body text-[15px] leading-[1.7] text-[var(--text-muted-on-cream)]">Chef-led private dining in Chennai's homes, villas, and boutique venues along ECR.</p>
        </Card>
      </a>
      <a href="/services/pan-india-catering" class="block">
        <Card variant="location" class="h-full">
          <span class="mb-2 block font-body text-[10px] tracking-[0.25em] text-gray-orange uppercase">Pan India</span>
          <h3 class="mb-3 font-serif text-xl font-light leading-snug text-dark-brown">Pan India Catering</h3>
          <p class="font-body text-[15px] leading-[1.7] text-[var(--text-muted-on-cream)]">Chennai-coordinated events that require travel — anywhere in India.</p>
        </Card>
      </a>
    </div>
  </section>

  <!-- Venues section -->
  <section class="bg-light-blush px-5 py-20 md:px-10 lg:px-20 lg:py-[90px]">
    <div class="mb-12 grid grid-cols-1 gap-6 lg:grid-cols-[1fr_auto]">
      <div>
        <SectionEyebrow class="mb-4">Chennai's Premier Properties</SectionEyebrow>
        <h2 class="font-serif text-[clamp(28px,3vw,44px)] font-light leading-tight text-dark-brown">
          Venues we know <em class="italic text-dark-red">from the inside</em>
        </h2>
      </div>
      <div class="flex items-end">
        <Button href={WHATSAPP_QUOTE_URL} variant="outlineCta">Book Your Event</Button>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-px bg-[rgba(189,148,118,0.2)] sm:grid-cols-3 lg:grid-cols-6">
      {[
        'ITC Grand Chola',
        'Taj Coromandel',
        'The Leela Palace',
        'Park Hyatt Chennai',
        'Conrad Chennai',
        'Sheraton Grand',
      ].map((venue) => (
        <div class="bg-cream px-5 py-6 text-center">
          <span class="font-body text-[13px] leading-[1.6] tracking-[0.06em] text-[var(--text-muted-on-cream)]">{venue}</span>
        </div>
      ))}
    </div>
    <p class="mt-6 font-body text-[14px] text-[var(--text-muted-on-cream-soft)]">
      We operate across Chennai — from five-star properties on GST Road to ECR resorts, Guindy convention spaces, and private residences in the city centre.
    </p>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>
