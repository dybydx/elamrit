---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/shared/Nav.astro';
import PageHero from '@/components/shared/PageHero.astro';
import SectionHeader from '@/components/shared/SectionHeader.astro';
import Button from '@/components/ui/Button.astro';
import SiteFooter from '@/components/shared/SiteFooter.astro';
import RelatedBlogCards from '@/components/journal/RelatedBlogCards.astro';
import RelatedEventCards from '@/components/journal/RelatedEventCards.astro';
import { formatBlogDate } from '@/lib/blog';
import { relatedBlogPostsExcluding, relatedEventsByTag } from '@/lib/journal-related';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allBlog = await getCollection('blog');
const allEvents = await getCollection('events');
const relatedBlogs = relatedBlogPostsExcluding(allBlog, post.id, post.data.tag);
const relatedEvents = relatedEventsByTag(allEvents, post.data.tag);
const showRelated = relatedBlogs.length > 0 || relatedEvents.length > 0;

const breadcrumb = [
  { label: 'Home', href: '/' },
  { label: 'Journal', href: '/journal' },
  { label: 'Blog', href: '/blog' },
  {
    label: post.data.breadcrumbTitle,
    title: post.data.title,
  },
];

const title = `${post.data.title} — Elamrit Blog`;
const description = post.data.excerpt;
import { WHATSAPP_QUOTE_URL } from '@/lib/contact';
---

<BaseLayout
  {title}
  {description}
  bottomCta="about"
  ogType="article"
  image={post.data.heroImageSrc}
  article={{
    headline: post.data.title,
    datePublished: post.data.publishedAt,
    section: post.data.tag,
  }}
>
  <Nav variant="solid" />

  <PageHero
    variant="article"
    breadcrumb={breadcrumb}
    title={post.data.title}
    description={`${formatBlogDate(post.data.publishedAt)} · ${post.data.tag}`}
    imageClass="ph-image"
    heroImageSrc={post.data.heroImageSrc}
    quote={post.data.quote}
    quoteAttribution={post.data.quoteAttribution}
  >
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href={WHATSAPP_QUOTE_URL} variant="creamOnDark">Get a Quote</Button>
      <Button href="/blog" variant="outlineCream">All posts</Button>
    </div>
  </PageHero>

  <article class="bg-cream px-5 py-20 md:px-10 lg:px-20 lg:py-[100px]">
    <div class="blog-prose mx-auto max-w-[720px]">
      <p class="mb-12 font-body text-[17px] leading-[1.85] text-[var(--text-muted-on-cream)]">{post.data.excerpt}</p>
      <Content />
    </div>

    {
      showRelated ? (
        <>
          {relatedBlogs.length > 0 ? (
            <section class="journal-related-band">
              <div class="mx-auto w-full max-w-[1100px]">
                <SectionHeader class="mb-8" label="Blog" align="center" showDivider={true}>
                  Related <em>articles</em>
                </SectionHeader>
                <RelatedBlogCards posts={relatedBlogs} />
              </div>
            </section>
          ) : null}
          {relatedEvents.length > 0 ? (
            relatedBlogs.length > 0 ? (
              <div class="mx-auto mt-16 w-full max-w-[1100px] border-t border-[rgba(189,148,118,0.28)] pt-16">
                <SectionHeader class="mb-8" label="Events" align="center" showDivider={true}>
                  Related <em>showcases</em>
                </SectionHeader>
                <RelatedEventCards events={relatedEvents} />
              </div>
            ) : (
              <section class="journal-related-band">
                <div class="mx-auto w-full max-w-[1100px]">
                  <SectionHeader class="mb-8" label="Events" align="center" showDivider={true}>
                    Related <em>showcases</em>
                  </SectionHeader>
                  <RelatedEventCards events={relatedEvents} />
                </div>
              </section>
            )
          ) : null}
        </>
      ) : null
    }

    <div class="mx-auto mt-16 flex max-w-[720px] flex-wrap justify-between gap-4 border-t border-[rgba(189,148,118,0.28)] pt-10">
      <Button href="/blog" variant="outlineCta">← Back to blog</Button>
      <Button href="/events" variant="outlineCta">Event showcases</Button>
    </div>
  </article>

  <SiteFooter slot="footer" />
</BaseLayout>
