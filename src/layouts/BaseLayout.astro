---
import '../styles/app.css';
import PageCta from '@/components/shared/PageCta.astro';
import {
  AREA_SERVED,
  DEFAULT_OG_IMAGE_HEIGHT,
  DEFAULT_OG_IMAGE_WIDTH,
  SITE_BRAND,
  SITE_EMAIL,
  SITE_LEGAL_NAME,
  SITE_LOGO_PATH,
  SITE_PHONE_DISPLAY,
  SITE_PHONE_SCHEMA,
  SOCIAL_URLS,
} from '@/lib/site-seo';

const DEFAULT_OG_IMAGE = '/images/gallery/elamrit-gallery-wedding-feast.webp';
const SITE_FALLBACK = 'https://elamrit.com';

interface ArticleMeta {
  headline: string;
  datePublished: string;
  dateModified?: string;
  section?: string;
}

interface EventMeta {
  name: string;
  startDate: string;
  location?: string;
}

interface Props {
  title: string;
  description: string;
  bottomCta?: false | 'home' | 'about';
  /** Site-root path (leading /) for og:image and twitter:image */
  image?: string;
  ogType?: 'website' | 'article';
  robots?: string;
  /** Omit default Organization + WebSite (+ optional BlogPosting / Event) JSON-LD */
  noJsonLd?: boolean;
  article?: ArticleMeta;
  event?: EventMeta;
}

const {
  title,
  description,
  bottomCta = false,
  image: imageProp,
  ogType = 'website',
  robots = 'index, follow',
  noJsonLd = false,
  article,
  event,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(SITE_FALLBACK);
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const imagePath = imageProp ?? DEFAULT_OG_IMAGE;
const ogImageURL = new URL(imagePath, siteUrl).href;
const logoURL = new URL(SITE_LOGO_PATH, siteUrl).href;
const siteOrigin = siteUrl.origin;

const gaId =
  typeof import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID === 'string'
    ? import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID.trim()
    : '';

const orgId = `${siteOrigin}/#organization`;
const websiteId = `${siteOrigin}/#website`;
const businessId = `${siteOrigin}/#foodestablishment`;

const sameAs = [SOCIAL_URLS.instagram, SOCIAL_URLS.facebook, SOCIAL_URLS.linkedin].filter(
  (url) => url.length > 0,
);

const jsonLdGraph: Record<string, unknown>[] = [];

if (!noJsonLd) {
  jsonLdGraph.push(
    {
      '@type': 'Organization',
      '@id': orgId,
      name: SITE_BRAND,
      legalName: SITE_LEGAL_NAME,
      url: siteOrigin,
      logo: logoURL,
      description:
        'Premium luxury catering for weddings, corporate events, and celebrations across Pune and Pan India.',
      ...(sameAs.length > 0 ? { sameAs } : {}),
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: SITE_PHONE_SCHEMA,
        email: SITE_EMAIL,
        contactType: 'customer service',
        areaServed: 'IN',
        availableLanguage: ['English', 'Hindi'],
      },
    },
    {
      '@type': 'FoodEstablishment',
      '@id': businessId,
      name: SITE_LEGAL_NAME,
      url: siteOrigin,
      image: logoURL,
      telephone: SITE_PHONE_SCHEMA,
      email: SITE_EMAIL,
      servesCuisine: ['Indian', 'International', 'Fusion'],
      areaServed: AREA_SERVED.map((name) => ({
        '@type': 'City',
        name,
      })),
      parentOrganization: { '@id': orgId },
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: SITE_BRAND,
      url: siteOrigin,
      publisher: { '@id': orgId },
    },
  );

  if (article) {
    jsonLdGraph.push({
      '@type': 'BlogPosting',
      headline: article.headline,
      description,
      datePublished: article.datePublished,
      dateModified: article.dateModified ?? article.datePublished,
      image: [ogImageURL],
      author: { '@type': 'Organization', name: SITE_BRAND },
      publisher: { '@id': orgId },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.href,
      },
      ...(article.section ? { articleSection: article.section } : {}),
    });
  }

  if (event) {
    jsonLdGraph.push({
      '@type': 'Event',
      name: event.name,
      description,
      startDate: event.startDate,
      image: [ogImageURL],
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      organizer: { '@id': orgId },
      ...(event.location
        ? {
            location: {
              '@type': 'Place',
              name: event.location,
            },
          }
        : {}),
    });
  }
}

const jsonLdSafe =
  jsonLdGraph.length > 0
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': jsonLdGraph,
      }).replace(/</g, '\\u003c')
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#24211f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL.href} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_BRAND} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={`${SITE_LEGAL_NAME} — premium catering`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {article ? <meta property="article:published_time" content={article.datePublished} /> : null}
    {article?.dateModified ? (
      <meta property="article:modified_time" content={article.dateModified} />
    ) : null}
    {article?.section ? <meta property="article:section" content={article.section} /> : null}

    {jsonLdSafe ? <script type="application/ld+json" set:html={jsonLdSafe} /> : null}

    {
      gaId ? (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      ) : null
    }

    <slot name="head" />
  </head>
  <body>
    <slot />
    {bottomCta ? <PageCta variant={bottomCta} /> : null}
    <slot name="footer" />
  </body>
</html>
