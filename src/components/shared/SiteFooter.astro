---
import { WHATSAPP_QUOTE_URL } from '@/lib/contact';
import { SOCIAL_URLS } from '@/lib/site-seo';

export interface Props {
  showMark?: boolean;
}

const { showMark = true } = Astro.props;

const socialLinks = [
  { href: SOCIAL_URLS.instagram, label: 'Instagram' },
  { href: SOCIAL_URLS.facebook, label: 'Facebook' },
  { href: SOCIAL_URLS.linkedin, label: 'LinkedIn' },
].filter((item) => item.href.length > 0);
---

<footer class="site-footer border-t-[3px] border-green bg-dark-red pb-8 text-blush">
  <div class="px-5 pt-[72px] md:px-10 lg:px-20">
    <div
      class="grid grid-cols-1 gap-10 border-b border-[rgba(189,148,118,0.15)] pb-14 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr] lg:gap-[60px]"
    >
      <div class="footer-brand">
        <div class="mb-4 flex items-center gap-3.5">
          {showMark ? (
            <svg class="h-[34px] w-7 shrink-0 text-cream/50" viewBox="0 0 60 75" fill="none" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="30" cy="14" rx="6" ry="10" stroke="currentColor" stroke-width="1.5"></ellipse>
              <line x1="30" y1="5" x2="30" y2="23" stroke="currentColor" stroke-width="0.8"></line>
              <path d="M27 16 C20 13 11 7 4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              <path d="M26 20 C17 19 8 14 2 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              <path d="M25 24 C18 25 10 23 5 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              <path d="M33 16 C40 13 49 7 56 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              <path d="M34 20 C43 19 52 14 58 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              <path d="M35 24 C42 25 50 23 55 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              <line x1="30" y1="23" x2="30" y2="52" stroke="currentColor" stroke-width="1.5"></line>
              <path d="M30 52 C24 57 16 61 8 64" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
              <path d="M30 52 C36 57 44 61 52 64" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
          ) : null}
          <div class="flex flex-col gap-0.5">
            <div class="logo-name font-display text-xl leading-none tracking-[0.45em] text-cream">ELAMRIT</div>
            <div class="logo-tag font-serif text-[11px] tracking-[0.26em] text-gray-orange uppercase">Luxe Feast</div>
          </div>
        </div>
        <p class="mb-7 max-w-[280px] font-body text-[16px] leading-[1.85] text-on-dark-red-muted">
          Premium catering crafted for life's most significant moments. Pune-based. Pan India. Singapore — coming soon.
        </p>
        {
          socialLinks.length > 0 ? (
            <nav class="flex gap-3" aria-label="Social media">
              {socialLinks.map((item) => (
                <a
                  class="footer-social-link flex h-[34px] w-[34px] items-center justify-center border border-[rgba(189,148,118,0.25)] text-gray-orange transition-all duration-200 hover:border-gray-orange hover:bg-[rgba(189,148,118,0.08)] hover:text-cream"
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={item.label}
                >
                  {item.label === 'Instagram' ? (
                    <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
                    </svg>
                  ) : item.label === 'Facebook' ? (
                    <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" stroke-linejoin="round" />
                    </svg>
                  ) : (
                    <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-13h4v2" stroke-linecap="round" stroke-linejoin="round" />
                      <rect x="2" y="9" width="4" height="12" rx="0.5" />
                      <circle cx="4" cy="4" r="2" />
                    </svg>
                  )}
                </a>
              ))}
            </nav>
          ) : null
        }
      </div>

      <div class="footer-col">
        <h3
          class="mb-6 border-b border-[rgba(189,148,118,0.12)] pb-3 font-body text-[12px] tracking-[0.26em] text-cream uppercase"
        >
          Services
        </h3>
        <ul class="flex list-none flex-col gap-2.5">
          <li><a href="/services/wedding-catering" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">Wedding Catering</a></li>
          <li><a href="/services/corporate-catering" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">Corporate Events</a></li>
          <li><a href="/services/social-celebrations" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">Social Celebrations</a></li>
          <li><a href="/services/private-dining" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">Private Dining</a></li>
          <li><a href="/services/live-stations" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">Live Stations</a></li>
          <li><a href="/services/pan-india-catering" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">Pan India Catering</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3
          class="mb-6 border-b border-[rgba(189,148,118,0.12)] pb-3 font-body text-[12px] tracking-[0.26em] text-cream uppercase"
        >
          Explore
        </h3>
        <ul class="flex list-none flex-col gap-2.5">
          <li><a href="/about" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">About Elamrit</a></li>
          <li><a href="/menus" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">Menus</a></li>
          <li><a href="/gallery" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">Gallery</a></li>
          <li><a href="/journal" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">Journal</a></li>
          <li><a href="/blog" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">Blog</a></li>
          <li><a href="/events" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">Events</a></li>
          <li><a href="/food-junction" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">Food Junction</a></li>
          <li><a href="/testimonials" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream">Testimonials</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3
          class="mb-6 border-b border-[rgba(189,148,118,0.12)] pb-3 font-body text-[12px] tracking-[0.26em] text-cream uppercase"
        >
          Get in Touch
        </h3>
        <ul class="flex list-none flex-col gap-2.5">
          <li>
            <a
              href={WHATSAPP_QUOTE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream"
              >Get a Quote</a
            >
          </li>
          <li>
            <a href="/contact" class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream"
              >Contact Us</a
            >
          </li>
          <!-- <li>
            <a
              href={WHATSAPP_QUOTE_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="font-body text-[16px] text-on-dark-red-muted transition-colors hover:text-cream"
              >WhatsApp Us</a
            >
          </li> -->
        </ul>
        <div class="mt-7 border-t border-[rgba(189,148,118,0.1)] pt-5">
          <div class="font-body text-[12px] leading-8 tracking-[0.22em] text-on-dark-red-subtle uppercase">
            Pune &nbsp;·&nbsp; Mumbai &nbsp;·&nbsp; Delhi<br />
            Bangalore &nbsp;·&nbsp; Hyderabad &nbsp;·&nbsp; Chennai<br />
            Pan India
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-4 px-5 pt-7 md:px-10 lg:px-20">
    <p class="font-body text-sm tracking-wide text-on-dark-red-subtle">
      © 2025 Elamrit Luxe Feast. All rights reserved.
    </p>
    <p class="font-body text-sm tracking-wide text-on-dark-red-subtle">
      <a class="text-on-dark-red-muted transition-colors hover:text-cream" href="/privacy-policy">Privacy Policy</a>
      &nbsp;·&nbsp;
      <a class="text-on-dark-red-muted transition-colors hover:text-cream" href="/terms">Terms &amp; Conditions</a>
    </p>
    <div class="footer-agency flex items-center gap-1.5 font-body text-sm text-on-dark-red-subtle">
      Designed &amp; developed by&nbsp;<a class="text-gray-orange transition-colors hover:text-cream" href="https://webweaverlabs.com" target="_blank">WebWeaver Labs</a>
    </div>
  </div>
</footer>

