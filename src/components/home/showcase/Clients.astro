---
import { cn } from '@/lib/utils';

type ClientLogoTreatment = 'multiply' | 'roundedDark' | 'default';

interface ClientLogo {
  name: string;
  src: string;
  treatment?: ClientLogoTreatment;
}

/** SVG wordmarks from official/Wikimedia sources; PNGs use multiply on cream where needed. */
const clients: ClientLogo[] = [
  { name: 'HSBC', src: '/images/clients/hsbc.svg' },
  { name: 'Workday', src: '/images/clients/workday.svg' },
  { name: 'Globant', src: '/images/clients/globant.svg' },
  { name: 'Boston Scientific', src: '/images/clients/boston-scientific.svg' },
  { name: 'Sage', src: '/images/clients/sage-tr.png' },
  { name: 'Vector', src: '/images/clients/vector.svg' },
  { name: 'Globeflex', src: '/images/clients/globeflex.png', treatment: 'multiply' },
  { name: 'Amrut Software', src: '/images/clients/amrut.svg' },
  { name: 'KARA', src: '/images/clients/kara.png' },
  { name: 'me-HR', src: '/images/clients/mehr-.png' },
  { name: 'Mittal Brothers', src: '/images/clients/mittal-brothers.png', treatment: 'roundedDark' },
  { name: 'Parakh Foods', src: '/images/clients/parakh-tr.png' },
];

const clientsWrapperClasses = 'clients-track-wrapper relative overflow-hidden';
const clientsTrackClasses =
  'flex w-max items-center gap-0 [animation:logo-scroll_40s_linear_infinite] hover:[animation-play-state:paused]';
---

<section
  id="clients"
  class="overflow-hidden border-y border-[rgba(81,3,12,0.08)] bg-cream py-16"
>
  <p class="mb-10 text-center font-body text-[11px] tracking-[0.4em] text-label-on-cream uppercase">
    Trusted by India's Leading Corporates
  </p>
  <div class={clientsWrapperClasses}>
    <div class={clientsTrackClasses}>
      {
        [...clients, ...clients].map((client) => (
          <>
            <div class="client-logo flex shrink-0 items-center justify-center px-10 md:px-[52px]">
              <div
                class={cn(
                  'client-logo-shell',
                  client.treatment === 'roundedDark' && 'client-logo-shell--rounded-dark',
                )}
              >
                <img
                  src={client.src}
                  alt={client.name}
                  width={160}
                  height={48}
                  loading="lazy"
                  decoding="async"
                  class={cn(
                    'client-logo-img',
                    client.treatment === 'multiply' && 'client-logo-img--multiply',
                    client.treatment === 'roundedDark' && 'client-logo-img--on-dark',
                  )}
                />
              </div>
            </div>
            <div class="h-0.5 w-0.5 shrink-0 rounded-full bg-dark-red/20" aria-hidden="true" />
          </>
        ))
      }
    </div>
  </div>
</section>
