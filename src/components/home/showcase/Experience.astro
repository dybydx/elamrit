---
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
---
  <section
    id="experience"
    class="grid grid-cols-1 items-center gap-10 bg-dark-red px-5 py-20 md:gap-20 md:px-10 lg:grid-cols-2 lg:px-20 lg:py-20"
  >
    <div class="exp-left">
      <h2 class="font-serif text-[clamp(30px,3.5vw,48px)] font-light leading-tight text-cream">
        Every Feast is a <em class="italic">Carefully Composed</em> Story
      </h2>
      <p class="mt-6 max-w-[440px] font-body text-xl leading-[1.85] text-cream/70">
        We believe that catering is not merely feeding — it is the art of creating an atmosphere, a memory, an emotion.
        Our team of master chefs, event specialists, and service professionals work in seamless choreography to bring
        your vision to life.
      </p>
      <div class="mt-11 flex flex-wrap items-center gap-7">
        <Button href="/about" variant="cream">Our Philosophy</Button>
        <Button type="button" variant="outlineCream" data-how-we-work-open>How We Work</Button>
      </div>
    </div>
    <div class="grid grid-cols-1 gap-0.5 sm:grid-cols-2">
      <Card variant="experienceTile">
        <span class="mb-2 block font-body text-[10px] tracking-[0.25em] text-blush uppercase">Cuisine</span>
        <span class="font-serif text-xl italic leading-snug text-cream"
          >Indian, International & Fusion — from Rajasthani dals to Mediterranean mezze</span
        >
      </Card>
      <Card variant="experienceTile">
        <span class="mb-2 block font-body text-[10px] tracking-[0.25em] text-blush uppercase">Presentation</span>
        <span class="font-serif text-xl italic leading-snug text-cream"
          >Editorial plating and live station theatre that commands attention</span
        >
      </Card>
      <Card variant="experienceTile">
        <span class="mb-2 block font-body text-[10px] tracking-[0.25em] text-blush uppercase">Reach</span>
        <span class="font-serif text-xl italic leading-snug text-cream"
          >Pan India deployment with full logistics — Pune, Mumbai, Delhi, Goa &amp; beyond</span
        >
      </Card>
      <Card variant="experienceTile">
        <span class="mb-2 block font-body text-[10px] tracking-[0.25em] text-blush uppercase">Bespoke</span>
        <span class="font-serif text-xl italic leading-snug text-cream"
          >Custom menus built around your event, dietary needs, and cultural traditions</span
        >
      </Card>
    </div>

    <dialog
      class="how-we-work-modal m-auto max-h-[100dvh] w-[min(100dvw-2rem,56rem)] border-0 bg-dark-brown/98 p-0 text-cream shadow-[0_24px_80px_rgba(0,0,0,0.45)] backdrop:bg-black/75 open:flex open:flex-col"
      data-how-we-work-dialog
      aria-labelledby="how-we-work-title"
    >
      <div class="flex items-center justify-between gap-4 border-b border-cream/10 px-4 py-3 sm:px-5">
        <h3
          id="how-we-work-title"
          class="font-body text-[13px] tracking-[0.22em] text-cream/90 uppercase sm:text-sm"
        >
          How We Work
        </h3>
        <form method="dialog">
          <button
            type="submit"
            class="min-h-[44px] min-w-[44px] font-body text-[13px] tracking-[0.2em] text-cream uppercase underline-offset-4 hover:underline"
          >
            Close
          </button>
        </form>
      </div>
      <div class="p-4 sm:p-5">
        <!-- Replace `src` when the final process reel is ready -->
        <video
          class="aspect-video w-full rounded-sm bg-black object-contain"
          controls
          playsinline
          preload="metadata"
          poster="/images/hero-poster.webp"
          src="/videos/hero-reel.mp4"
        ></video>
      </div>
    </dialog>
  </section>

  <script>
    function initHowWeWorkModal(root: HTMLElement): void {
      const openBtn = root.querySelector<HTMLButtonElement>('[data-how-we-work-open]');
      const dialog = root.querySelector<HTMLDialogElement>('[data-how-we-work-dialog]');
      const video = dialog?.querySelector('video');
      if (!openBtn || !dialog) return;

      openBtn.addEventListener('click', () => {
        dialog.showModal();
      });

      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });

      dialog.addEventListener('close', () => {
        if (!video) return;
        video.pause();
        video.currentTime = 0;
      });
    }

    const experience = document.getElementById('experience');
    if (experience) initHowWeWorkModal(experience);
  </script>
